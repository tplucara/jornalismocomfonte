# Copie para .env e ajuste. Nunca commite o .env.
# Credenciais abaixo são só para desenvolvimento local.

POSTGRES_PASSWORD=jcf_dev_only
JCF_WEB_DB_PASSWORD=jcf_web_dev_only
JCF_WORKER_DB_PASSWORD=jcf_worker_dev_only

# Salt para hash de IP em logs/auditoria. Rotacione periodicamente em produção.
IP_HASH_SALT=dev-rotate-me

# Chave de cifra da PII de terceiros (pgp_sym_encrypt). Só o worker/admin a recebe.
PII_ENCRYPTION_KEY=dev-only-key

# Endereço público servido pelo Caddy. Em produção: seu domínio (Caddy obtém TLS sozinho).
SITE_ADDRESS=:80
